# Copie este arquivo para .env e preencha com suas chaves
# cp .env.example .env

# Google Cloud Vision API - para OCR de comprovantes (Meus gastos)
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
# Na Vercel, use também GOOGLE_VISION_API_KEY (server) na rota /api/vision/ocr
# GOOGLE_VISION_API_KEY=
# URL do site com API (localhost Expo usa isso para OCR sem CORS)
EXPO_PUBLIC_SITE_URL=https://tudocerto-web.vercel.app
# Local (npm run web:api + npm run web): EXPO_PUBLIC_VISION_API_URL=http://localhost:3000
