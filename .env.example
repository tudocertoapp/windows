# Copie para .env: cp .env.example .env
# Mesmas variáveis devem existir na Vercel (Settings → Environment Variables).

# --- App (Expo / frontend) ---
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://tudocerto-web.vercel.app
EXPO_PUBLIC_STRIPE_API_URL=https://tudocerto-web.vercel.app
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
GOOGLE_VISION_API_KEY=
# Web dev: https://SEU_DEPLOY.vercel.app ou local: EXPO_PUBLIC_VISION_API_URL=http://localhost:3000 + npm run web:api
EXPO_PUBLIC_VISION_API_URL=

# --- Supabase (servidor — NUNCA expor no app) ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (servidor — NUNCA expor no app) ---
# Secret key: sk_test_... ou sk_live_... (NÃO use rk_ Restricted key)
STRIPE_SECRET_KEY=
# Webhook: Stripe Dashboard → Webhooks → endpoint /api/stripe/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Gemini Flash (servidor — NUNCA EXPO_PUBLIC_*) ---
# Google AI Studio → API key. Na Vercel: Settings → Environment Variables.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-2.0-flash
GEMINI_MODEL=

# --- Assistente Dock (servidor). Prompt e ferramentas do app não mudam. ---
# DeepSeek (padrão se a chave existir): https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Groq fica de reserva se não houver DeepSeek
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# native = Dock no sistema, sem API de chat. llama/groq/deepseek = IA externa.
AI_PROVIDER=native

# Google Vision desativado (não usar)
# GOOGLE_VISION_API_KEY=
