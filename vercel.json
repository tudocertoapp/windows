{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run web:build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/ai/chat", "destination": "/api/vision/ocr?task=assistant" },
    { "source": "/q/:code", "destination": "/api/qr/go?code=:code" },
    { "source": "/q/:code/", "destination": "/api/qr/go?code=:code" },
    { "source": "/((?!api/|q/).*)", "destination": "/index.html" }
  ]
}
